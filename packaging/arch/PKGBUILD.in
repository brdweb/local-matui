# Private development package wrapping the verified release executable.
# Generated checksums and glibc requirement come from stage.py.
pkgname=matui
pkgver=0.1.0
pkgrel=1
pkgdesc='Terminal controller and embedded Sendspin player for Music Assistant (development build)'
arch=('x86_64')
license=('custom')
depends=('glibc>=@GLIBC@' 'gcc-libs' 'alsa-lib' 'ca-certificates' 'libsecret')
optdepends=('pipewire-alsa: route ALSA output through PipeWire on Omarchy'
            'gnome-keyring: desktop Secret Service for saved logins')
options=('!strip' '!debug')
source=('matui' 'README.md' 'INSTALL.txt' 'THIRD-PARTY-NOTICES.tar.gz' 'DEVELOPMENT-STATUS')
sha256sums=(@SHA256SUMS@)

package() {
    install -Dm755 "$srcdir/matui" "$pkgdir/usr/bin/matui"
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/matui/README.md"
    install -Dm644 "$srcdir/INSTALL.txt" "$pkgdir/usr/share/doc/matui/INSTALL.txt"
    install -Dm644 "$srcdir/DEVELOPMENT-STATUS" "$pkgdir/usr/share/licenses/matui/DEVELOPMENT-STATUS"
    cp -r "$srcdir/third-party" "$pkgdir/usr/share/licenses/matui/"
    chmod -R u=rwX,go=rX "$pkgdir/usr/share/licenses/matui"
}
